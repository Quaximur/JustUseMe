<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_App/UIToolkit/Screens/Settings/SettingsStyles.uss?fileID=7433441132597879392&amp;guid=30f779d9fb6fcbd4dbb865b56c1d47a6&amp;type=3#SettingsStyles"/>
    <ui:VisualElement name="SettingsWrapper" picking-mode="Ignore" class="jum__window-wrapper settings__root" style="flex-grow: 1; align-items: center; justify-content: center;">
        <ui:VisualElement name="SettingsPanel" class="jum__root-panel settings__panel" style="flex-grow: 1;">
            <ui:VisualElement name="Header" class="settings__header">
                <ui:Label class="jum__view-title" style="flex-shrink: 1;"/>
            </ui:VisualElement>
            <ui:Button name="CloseButton" text="×" focusable="false" class="jum__close-button"/>
            <ui:VisualElement name="TabButtonsContainer" style="flex-direction: row; justify-content: center; margin-bottom: 20px; flex-shrink: 0; height: 40px;"/>
            <ui:VisualElement name="SettingsContent" style="flex-grow: 1; flex-direction: row;">
                <ui:VisualElement name="SectionsContainer" class="jum__widget-panel settings__sections" style="flex-grow: 1; padding-left: 0;">
                    <ui:ScrollView class="settings__section jum__scroll-view"/>
                </ui:VisualElement>
                <ui:VisualElement name="SettingInfo" class="jum__widget-panel settings__info-panel">
                    <ui:VisualElement name="ControlInfoContainer" style="flex-grow: 1;">
                        <ui:Label text="Label" class="settings__info-title"/>
                        <ui:Label text="Lorem ipsum dolor sit amet, consectetur adipiscing elit,  sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam " class="settings__info-description"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="ActionsContainer" class="settings__actions" style="margin-top: 20px;">
                <ui:Button name="ApplyButton" focusable="false" class="jum__control-button jum__control-button--cyan settings__button">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:2996443a36c36ba42b1314b90733aeae" entry="Id(12368567151493120)"/>
                    </Bindings>
                </ui:Button>
                <ui:Button name="CancelChangesButton" focusable="false" class="jum__control-button jum__control-button--red settings__button" style="margin-left: 20px;">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:2996443a36c36ba42b1314b90733aeae" entry="Id(12368639369019392)"/>
                    </Bindings>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
